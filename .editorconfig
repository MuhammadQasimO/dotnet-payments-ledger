root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Code style
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = true:warning
csharp_prefer_simple_using_statement = true:suggestion

# .NET formatting
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Analyzer severities
dotnet_diagnostic.CA1062.severity = none      # Validate args of public methods (handled by nullability)
dotnet_diagnostic.CA1031.severity = none      # Catch general exception (intentional in middleware)
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait — ASP.NET Core has no sync context
dotnet_diagnostic.CA1303.severity = none      # Pass strings as localised resource
dotnet_diagnostic.CA1812.severity = none      # Internal class never instantiated (DI)
dotnet_diagnostic.CA1848.severity = none      # Use LoggerMessage delegates
dotnet_diagnostic.CA2254.severity = none      # Log message template should be constant
dotnet_diagnostic.IDE0058.severity = none     # Expression value never used
dotnet_diagnostic.CA1861.severity = none      # Constant array as argument (noisy in EF migrations)
dotnet_diagnostic.CA1305.severity = none      # Specify IFormatProvider (Money is invariant by design)
dotnet_diagnostic.CA1310.severity = none      # StringComparison overload (Ordinal is the project default)
dotnet_diagnostic.CA1054.severity = none      # URI parameter instead of string
dotnet_diagnostic.CA1056.severity = none      # URI property instead of string
